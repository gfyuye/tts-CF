{
  "name": "microsoft-tts-worker",
  "version": "1.0.0",
  "description": "Microsoft TTS proxy on Cloudflare Workers",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create tts-db",
    "db:init": "wrangler d1 execute tts-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute tts-db --local --file=schema.sql",
    "db:list": "wrangler d1 list"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
